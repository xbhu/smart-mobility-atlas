---
// A full Atlas page in one language. The header follows the familiar AI/robotics project page
// (centered title, authors, a row of resource buttons, one teaser image or video); the body is
// a plain-language article in the style of a research blog post, followed by the paper's
// abstract (folded) and the citation.
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import PaperHeader from "./PaperHeader.astro";
import LeadMedia from "./LeadMedia.astro";
import KeyNumbers from "./KeyNumbers.astro";
import Cite from "./Cite.astro";
import PressStrip from "./PressStrip.astro";
import Card from "./Card.astro";
import { atlasPages, pageImage, pagePath, type AtlasPage } from "../lib/pages";
import { ui, thrustName, type Lang } from "../lib/i18n";

interface Props { page: AtlasPage; lang: Lang }
const { page, lang } = Astro.props;
const t = ui[lang];
const { paper, thrust } = page;
const entry = lang === "zh" && page.zh ? page.zh : page.en;
const d = entry.data;
const en = page.en.data;
const hero = en.hero; // media is shared; captions can be translated
const caption = lang === "zh" ? (d.hero?.caption ?? hero?.caption) : hero?.caption;
const title = lang === "zh" && d.title ? d.title : paper.title;
const { Content } = await render(entry);

const enPath = pagePath(page.slug, "en");
const zhPath = page.zh ? pagePath(page.slug, "zh") : undefined;
const alternates = { en: enPath, ...(zhPath ? { zh: zhPath } : {}) };
const all = await atlasPages();
const sameThrust = all.filter((p) => p.slug !== page.slug && p.thrust.id === thrust.id);
const related = [...sameThrust, ...all.filter((p) => p.slug !== page.slug && p.thrust.id !== thrust.id)].slice(0, 3);
const updated = d.updated ?? en.updated;
const image = pageImage(page) ?? undefined;
const jsonld = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: d.tldr,
  inLanguage: lang === "zh" ? "zh-CN" : "en",
  url: new URL(pagePath(page.slug, lang), Astro.site).toString(),
  ...(image ? { image: new URL(image, Astro.site).toString() } : {}),
  ...(updated ? { dateModified: updated } : {}),
  publisher: { "@type": "Organization", name: "Penn State Smart Mobility Lab", url: "https://lab.mobilitypsu.com" },
  about: {
    "@type": "ScholarlyArticle",
    name: paper.title,
    author: paper.authors.map((a) => ({ "@type": "Person", name: a.name, ...(a.profile_url ? { url: a.profile_url } : {}) })),
    datePublished: String(paper.year),
    isPartOf: { "@type": "Periodical", name: paper.venue },
    ...(paper.doi ? { sameAs: `https://doi.org/${paper.doi}`, identifier: `doi:${paper.doi}` } : {}),
  },
};
---
<Base title={title} description={d.tldr} lang={lang} image={image} alternates={alternates} jsonld={jsonld}>
  <article class="paper">
    <nav class="paper-crumbs wrap" aria-label="Breadcrumb">
      <a href="/">{t.atlas}</a><span class="crumbs-sep" aria-hidden="true">/</span>
      <a class="thrust-tag" data-thrust={thrust.id} href={`/#${thrust.id}`}>{thrustName(thrust, lang)}</a>
    </nav>

    <PaperHeader
      paper={paper}
      lang={lang}
      title={title}
      affiliations={en.affiliations}
      authorAffiliations={en.author_affiliations}
      press={en.press}
      zhPath={zhPath}
      enPath={enPath}
    />

    {hero && (
      <section class="teaser">
        <LeadMedia hero={hero} lang={lang} title={title} caption={caption} />
      </section>
    )}

    <section class="tldr-row">
      <p class="tldr-text"><span class="tldr-label">TL;DR</span>{d.tldr}</p>
      {d.key_numbers && d.key_numbers.length > 0 && <KeyNumbers items={d.key_numbers} lang={lang} />}
    </section>

    <div class="story prose">
      <Content />
    </div>

    {en.press && <PressStrip press={en.press} lang={lang} />}

    {en.abstract && (
      <section class="story">
        <details class="abstract">
          <summary><span class="abstract-title">{t.abstract}</span><span class="abstract-note">{t.abstractNote}</span></summary>
          <div lang="en">{en.abstract.split(/\n\s*\n/).map((para) => <p>{para}</p>)}</div>
        </details>
      </section>
    )}

    <section class="story citation-block">
      <Cite paper={paper} lang={lang} />
      {updated && <p class="page-note">{t.updated} {updated} · <a href={thrust.url}>{t.thrustOnLab}</a></p>}
    </section>
  </article>

  {related.length > 0 && (
    <section class="section section--concrete" aria-labelledby="related-h">
      <div class="wrap">
        <div class="section-head">
          <h2 id="related-h">{t.moreAtlas}</h2>
          <a class="more" href="/">{t.allPapers} →</a>
        </div>
        <ul class="cards">{related.map((p) => <Card page={p} lang={lang} />)}</ul>
      </div>
    </section>
  )}
</Base>
