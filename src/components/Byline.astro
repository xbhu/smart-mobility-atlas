---
// Authors and venue under the title. Lab members link to their profile on the lab site.
import type { LabPaper } from "../lib/lab";
import { ui, type Lang } from "../lib/i18n";
interface Props { paper: LabPaper; lang: Lang }
const { paper, lang } = Astro.props;
const t = ui[lang];
const vol = [paper.volume && `${paper.volume}${paper.issue ? `(${paper.issue})` : ""}`, paper.pages].filter(Boolean).join(", ");
const status = paper.status === "accepted" ? t.accepted : paper.status === "under-review" ? t.underReview : null;
---
<p class="byline">
  {paper.authors.map((a, i) => (
    <>
      {a.profile_url ? <a href={a.profile_url}>{a.name}</a> : <span>{a.name}</span>}
      {a.corresponding && <span class="corr" title={t.corresponding}>*</span>}
      {i < paper.authors.length - 1 && ", "}
    </>
  ))}
</p>
<p class="venue">
  <em>{paper.venue}</em><span class="sep">·</span>{paper.year}{vol && <><span class="sep">·</span>{vol}</>}{status && <><span class="sep">·</span>{status}</>}
</p>
