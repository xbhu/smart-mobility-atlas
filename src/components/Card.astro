---
// One Atlas page as a card (home page grid, "more from the Atlas"). If the page's teaser is a
// looping video, the card shows its poster and plays the loop while hovered or focused.
import { pageImage, pageLoop, pagePath, venueYear, type AtlasPage } from "../lib/pages";
import { thrustName, type Lang } from "../lib/i18n";
interface Props { page: AtlasPage; lang?: Lang; showThrust?: boolean }
const { page, lang = "en", showThrust = false } = Astro.props;
const entry = lang === "zh" && page.zh ? page.zh : page.en;
const title = lang === "zh" && page.zh?.data.title ? page.zh.data.title : page.paper.title;
const img = pageImage(page);
const loop = pageLoop(page);
---
<li class="card-item" data-thrust={page.thrust.id}>
  <a class="card" href={pagePath(page.slug, lang === "zh" && page.zh ? "zh" : "en")}>
    <span class="card-media">
      {img && <img src={img} alt="" loading="lazy" />}
      {loop && <video data-src={loop.src} muted loop playsinline preload="none" aria-hidden="true"></video>}
      {loop && <span class="card-play" aria-hidden="true"><svg width="10" height="12" viewBox="0 0 14 16"><path d="M0 0l14 8-14 8z" fill="currentColor" /></svg>Video</span>}
    </span>
    <span class="card-body">
      <span class="card-kicker">
        {showThrust && <span class="thrust-dot" data-thrust={page.thrust.id}>{thrustName(page.thrust, lang)}</span>}
        <span>{venueYear(page.paper)}</span>
      </span>
      <span class="card-title">{title}</span>
      <span class="card-tldr">{entry.data.tldr}</span>
      <span class="card-meta">
        <span class="card-go">{lang === "zh" ? "阅读全文" : "Read more"} <span aria-hidden="true">→</span></span>
        {page.en.data.draft && <span>DRAFT</span>}
      </span>
    </span>
  </a>
</li>
