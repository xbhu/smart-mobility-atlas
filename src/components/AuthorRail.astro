---
// Authors with photos (lab members) in the side rail.
import type { LabPaper } from "../lib/lab";
import { ui, type Lang } from "../lib/i18n";
interface Props { paper: LabPaper; lang: Lang }
const { paper, lang } = Astro.props;
const t = ui[lang];
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).filter((c) => /[A-Z]/.test(c)).slice(0, 2).join("");
const roleZh: Record<string, string> = {
  Director: "实验室主任", Alumni: "实验室校友", "Postdoctoral Scholar": "博士后", "Ph.D. Student": "博士生",
  "M.S. Student": "硕士生", "Undergraduate Researcher": "本科生研究助理", "Visiting Scholar": "访问学者",
};
const role = (r: string | null) => (r && lang === "zh" ? (roleZh[r] ?? r) : r);
---
<section aria-labelledby="authors-h">
  <h2 id="authors-h">{t.authors}</h2>
  <ul class="authors">
    {paper.authors.map((a) => (
      <li class="author">
        <span class="author-photo" aria-hidden="true">{a.photo ? <img src={a.photo} alt="" loading="lazy" /> : initials(a.name)}</span>
        <span>
          {a.profile_url ? <a class="author-name" href={a.profile_url}>{a.name}</a> : <span class="author-name">{a.name}</span>}
          {(a.role || a.corresponding) && (
            <span class="author-role">{[role(a.role), a.corresponding && t.corresponding].filter(Boolean).join(" · ")}</span>
          )}
        </span>
      </li>
    ))}
  </ul>
</section>
